<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AudioPilotManager</RootNamespace>
    <AssemblyName>AudioPilotManager</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <Product>Audio Pilot Manager</Product>
    <Company>GitHixy</Company>
    <Authors>GitHixy</Authors>
    <Description>A modern, per-app and per-device audio mixer for Windows 10 and 11.</Description>
    <Copyright>Copyright © 2026 GitHixy</Copyright>

    <!-- No telemetry, no surprises. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <!-- DPI awareness is declared in app.manifest on purpose: this is a WPF app that only borrows the WinForms tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
