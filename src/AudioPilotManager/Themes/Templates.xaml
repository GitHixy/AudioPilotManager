<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AudioPilotManager.Controls">

    <!-- ============================================================ device picker item -->
    <DataTemplate x:Key="DeviceComboItem">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="13.5" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Style="{StaticResource Badge}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Default" Style="{StaticResource BadgeText}" />
                </Border>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource ControlBrush}">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ app icon (image, or a monogram) -->
    <DataTemplate x:Key="AppIcon">
        <Grid Width="44" Height="44">
            <Border CornerRadius="12" Background="{DynamicResource ControlBrush}" />
            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
            <Grid Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE7F5;" Style="{StaticResource Icon}" FontSize="19" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsSystem, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Solo button: lit while this app is soloed. -->
    <Style x:Key="SoloButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Content" Value="S" />
        <Setter Property="ToolTip" Value="Solo: mute every other app on this device" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSoloed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ app strip (mixer) -->
    <DataTemplate x:Key="AppStrip">
        <Border x:Name="Card" Style="{StaticResource Card}" Width="116" Padding="10,16,10,12" Margin="0,0,12,0"
                c:Entrance.Enabled="True" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Reset to 100%" c:Ui.Glyph="&#xE72C;" Command="{Binding ResetCommand}" />
                    <MenuItem Header="Solo this app" c:Ui.Glyph="&#xE9E9;" Command="{Binding SoloCommand}" />
                    <MenuItem Header="Mute / unmute" c:Ui.Glyph="&#xE74F;" Command="{Binding ToggleMuteCommand}" />
                    <Separator />
                    <MenuItem Header="Hide from mixer" c:Ui.Glyph="&#xED1A;" Command="{Binding HideCommand}" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Icon with a glow that breathes in while the app is making sound -->
                <Grid HorizontalAlignment="Center">
                    <Ellipse x:Name="Glow" Width="84" Height="84" Margin="-20" Fill="{DynamicResource AccentGlowBrush}" Opacity="0" IsHitTestVisible="False" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,12,0,8" />

                <Grid Grid.Row="2" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Style="{StaticResource FaderSlider}" Value="{Binding Volume, Mode=TwoWay}" c:Ui.IsMuted="{Binding IsMuted}"
                            AutomationProperties.Name="{Binding Name}" />
                    <c:LevelMeter Grid.Column="1" Width="4" Margin="2,9,0,9" Orientation="Vertical" Level="{Binding Level}"
                                  IsDimmed="{Binding IsMuted}" Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <TextBlock Text="{Binding Volume, Converter={StaticResource Percent}}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="%" FontSize="12" Margin="1,0,0,3" VerticalAlignment="Bottom" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Content="{Binding VolumeGlyph}"
                                  ToolTip="Mute" Margin="0,0,6,0" AutomationProperties.Name="Mute" />
                    <Button Style="{StaticResource SoloButton}" Command="{Binding SoloCommand}" AutomationProperties.Name="Solo" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter TargetName="Card" Property="Opacity" Value="0.72" />
            </DataTrigger>
            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ device (master) strip -->
    <DataTemplate x:Key="DeviceStrip">
        <Border Width="132" CornerRadius="14" Padding="1" Background="{DynamicResource AccentGradientDiagonalBrush}" c:Entrance.Enabled="True">
            <Border CornerRadius="13" Padding="10,16,10,12" Background="{DynamicResource PopupBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradientDiagonalBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,12,0,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                   ToolTip="{Binding Description}" />
                        <TextBlock Text="MASTER" FontSize="10" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Style="{StaticResource FaderSlider}" Value="{Binding Volume, Mode=TwoWay}" c:Ui.IsMuted="{Binding IsMuted}"
                                AutomationProperties.Name="{Binding Name}" />
                        <c:LevelMeter Grid.Column="1" Width="5" Margin="2,9,0,9" Orientation="Vertical" Level="{Binding Level}"
                                      IsDimmed="{Binding IsMuted}" Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <TextBlock Text="{Binding Volume, Converter={StaticResource Percent}}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="%" FontSize="12" Margin="1,0,0,3" VerticalAlignment="Bottom" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <ToggleButton Grid.Row="4" Style="{StaticResource MuteToggle}" Width="78" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                  Content="{Binding VolumeGlyph}" ToolTip="Mute device" AutomationProperties.Name="Mute device" />
                </Grid>
            </Border>
        </Border>
    </DataTemplate>

    <!-- ============================================================ compact app row (tray flyout) -->
    <DataTemplate x:Key="CompactAppRow">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}">
                <ContentPresenter.LayoutTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </ContentPresenter.LayoutTransform>
            </ContentPresenter>
            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,-2" />
                <Grid>
                    <Slider Value="{Binding Volume, Mode=TwoWay}" c:Ui.IsMuted="{Binding IsMuted}" AutomationProperties.Name="{Binding Name}" />
                    <c:LevelMeter Height="2" Margin="9,22,9,0" VerticalAlignment="Top" Level="{Binding Level}" IsDimmed="{Binding IsMuted}"
                                  Fill="{DynamicResource MeterBrush}" />
                </Grid>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Volume, Converter={StaticResource Percent}}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,12,8,0" />
            <ToggleButton Grid.Column="3" Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Content="{Binding VolumeGlyph}"
                          VerticalAlignment="Center" Margin="0,10,0,0" AutomationProperties.Name="Mute" />
        </Grid>
    </DataTemplate>

    <!-- ============================================================ device card (devices page) -->
    <DataTemplate x:Key="DeviceCard">
        <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,16" c:Entrance.Enabled="True" c:Entrance.Offset="8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBox" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="21" Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource StrongText}" FontSize="15" />
                            <Border Style="{StaticResource Badge}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Default" Style="{StaticResource BadgeText}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource ControlBrush}"
                                    Visibility="{Binding IsDefaultComms, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Calls" Style="{StaticResource BadgeText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Content="{Binding VolumeGlyph}"
                                          ToolTip="Mute" AutomationProperties.Name="Mute" />
                            <Grid Grid.Column="1" Margin="6,0,0,0">
                                <Slider Value="{Binding Volume, Mode=TwoWay}" c:Ui.IsMuted="{Binding IsMuted}" AutomationProperties.Name="{Binding Name}" />
                                <c:LevelMeter Height="3" Margin="9,26,9,0" VerticalAlignment="Top" Level="{Binding Level}" IsDimmed="{Binding IsMuted}"
                                              Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Volume, Converter={StaticResource Percent}, StringFormat={}{0}%}"
                                       Style="{StaticResource StrongText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Make default" Command="{Binding SetDefaultCommand}" Padding="12,7" FontSize="12.5"
                                Visibility="{Binding IsDefault, Converter={StaticResource InvBoolToVis}}" Margin="0,0,6,0" />
                        <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding ShowChannels, Mode=TwoWay}"
                                      Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}}" ToolTip="Channels and balance"
                                      Margin="0,0,6,0" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="Channels" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More" c:MenuButton.Enabled="True" AutomationProperties.Name="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Make default device" c:Ui.Glyph="&#xE73E;" Command="{Binding SetDefaultCommand}" />
                                    <MenuItem Header="Make default for calls" c:Ui.Glyph="&#xE717;" Command="{Binding SetDefaultCommsCommand}" />
                                    <Separator />
                                    <MenuItem Header="Show apps in mixer" c:Ui.Glyph="&#xE9E9;" Command="{Binding ShowInMixerCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Channels -->
                <Border Margin="64,14,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding ShowChannels, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasBalance, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Balance" Style="{StaticResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource BalanceSlider}" Value="{Binding Balance, Mode=TwoWay}" AutomationProperties.Name="Balance" />
                            <TextBlock Grid.Column="2" Text="{Binding Balance, Converter={StaticResource BalanceText}}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Centre" Command="{Binding ResetBalanceCommand}"
                                    Margin="6,0,0,0" Width="30" Height="30" FontSize="12" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Volume, Converter={StaticResource Percent}, StringFormat={}{0}%}"
                                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource AccentGradientDiagonalBrush}" />
                <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
