<Window x:Class="AudioPilotManager.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Pilot Manager notification"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Opacity="0" IsHitTestVisible="False">
    <Border Margin="24" CornerRadius="22" Padding="18,12,22,12" Background="{DynamicResource OsdBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Direction="270" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradientDiagonalBrush}">
                <TextBlock x:Name="GlyphText" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentForegroundBrush}" />
            </Border>
            <TextBlock x:Name="MessageText" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
