<UserControl x:Class="AudioPilotManager.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mixer" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0">
                    <Run Text="Every app using" /> <Run Text="{Binding SelectedMixerDevice.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=", live." />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock Text="Device" Style="{StaticResource CaptionText}" Margin="4,0,0,6" />
                <ComboBox Width="320" ItemsSource="{Binding MixerDevices}" SelectedItem="{Binding SelectedMixerDevice, Mode=TwoWay}"
                          ItemTemplate="{StaticResource DeviceComboItem}" AutomationProperties.Name="Mixer device" />
            </StackPanel>
        </Grid>

        <!-- First-run tips -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" Background="{DynamicResource AccentSoftBrush}"
                BorderThickness="0" Visibility="{Binding ShowTips, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xF4A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="Tips:" />
                    <Run Text="scroll over any fader to fine-tune (hold Shift for 1% steps) · " /><Run FontWeight="SemiBold" Text="S" /><Run Text=" solos an app · right-click an app for more · volumes are remembered next time the app opens." />
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Width="28" Height="28"
                        Command="{Binding DismissTipsCommand}" ToolTip="Got it" Margin="12,0,0,0" AutomationProperties.Name="Dismiss tips" />
            </Grid>
        </Border>

        <!-- Strips -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter Content="{Binding SelectedMixerDevice}" ContentTemplate="{StaticResource DeviceStrip}"
                              Visibility="{Binding SelectedMixerDevice, Converter={StaticResource NullToVis}}" />

            <Border Grid.Column="1" Width="1" Margin="18,12" Background="{DynamicResource DividerBrush}" />

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12"
                          PanningMode="HorizontalOnly">
                <ItemsControl ItemsSource="{Binding SelectedMixerDevice.Apps}" ItemTemplate="{StaticResource AppStrip}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding SelectedMixerDevice.HasApps, Converter={StaticResource InvBoolToVis}, FallbackValue=Collapsed}">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentGlowBrush}" Margin="-24" />
                    <Border CornerRadius="28" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="38" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="All quiet" Style="{StaticResource TitleText}" FontSize="20" HorizontalAlignment="Center" Margin="0,22,0,6" />
                <TextBlock Style="{StaticResource SubtitleText}" TextAlignment="Center"
                           Text="Apps show up here the moment they open an audio stream on this device, and leave when they close." />
            </StackPanel>

            <!-- No devices at all -->
            <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding HasDevices, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE7F5;" Style="{StaticResource Icon}" FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="No audio devices" Style="{StaticResource TitleText}" FontSize="20" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Style="{StaticResource SubtitleText}" TextAlignment="Center"
                           Text="Plug in speakers, headphones or a microphone and they'll appear here instantly." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
