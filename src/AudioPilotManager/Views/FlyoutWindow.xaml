<Window x:Class="AudioPilotManager.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AudioPilotManager.Controls"
        Title="Audio Pilot quick mixer"
        Width="384" SizeToContent="Height"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource FlyoutBrush}" Padding="18,16">
        <StackPanel x:Name="Panel">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </StackPanel.RenderTransform>
            <!-- Output picker -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding QuickOutput, Mode=OneWay}" MinHeight="36"
                          SelectionChanged="OnOutputPicked" AutomationProperties.Name="Output device">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="8,0,0,0" ToolTip="Open Audio Pilot Manager"
                        Click="OnOpenMainClick" AutomationProperties.Name="Open Audio Pilot Manager" />
            </Grid>

            <!-- Master -->
            <Border CornerRadius="12" Padding="12,8,8,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" DataContext="{Binding DefaultOutput}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MASTER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="9,0,0,-2" />
                        <Grid>
                            <Slider Value="{Binding Volume, Mode=TwoWay}" c:Ui.IsMuted="{Binding IsMuted}" AutomationProperties.Name="Master volume" />
                            <c:LevelMeter Height="3" Margin="9,23,9,0" VerticalAlignment="Top" Level="{Binding Level}" IsDimmed="{Binding IsMuted}"
                                          Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Volume, Converter={StaticResource Percent}, StringFormat={}{0}%}" Style="{StaticResource StrongText}"
                               FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,8,0" />
                    <ToggleButton Grid.Column="2" Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Content="{Binding VolumeGlyph}"
                                  VerticalAlignment="Center" Margin="0,10,0,0" AutomationProperties.Name="Mute output" />
                </Grid>
            </Border>

            <!-- Apps -->
            <TextBlock Text="Apps" Style="{StaticResource SectionText}" Margin="4,16,0,4" />
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DefaultOutput.Apps}" ItemTemplate="{StaticResource CompactAppRow}" Margin="0,0,6,0" />
            </ScrollViewer>
            <TextBlock Text="Nothing is playing right now." Style="{StaticResource CaptionText}" Margin="4,6,0,6"
                       Visibility="{Binding DefaultOutput.HasApps, Converter={StaticResource InvBoolToVis}, FallbackValue=Visible}" />

            <!-- Footer -->
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton DataContext="{Binding DefaultInput}" Visibility="{Binding Converter={StaticResource NullToVis}}"
                              IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Left" Padding="12,7" ToolTip="{Binding Name}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource Icon}" FontSize="14"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="Microphone" Margin="8,0,10,0" FontSize="12.5" />
                        <c:LevelMeter Width="56" Height="6" Level="{Binding Level}" IsDimmed="{Binding IsMuted}"
                                      Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                    </StackPanel>
                </ToggleButton>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding OpenPatreonCommand}" Padding="10,7"
                        ToolTip="Support Audio Pilot Manager on Patreon">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB52;" Style="{StaticResource Icon}" FontSize="12" Foreground="#FFFF5C72" />
                        <TextBlock Text="Support" Margin="7,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
