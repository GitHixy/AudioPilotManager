<Window x:Class="AudioPilotManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AudioPilotManager.Views"
        xmlns:c="clr-namespace:AudioPilotManager.Controls"
        Title="Audio Pilot Manager"
        Icon="/Assets/app.ico"
        Width="1040" Height="680" MinWidth="780" MinHeight="520"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="3" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="22,18,16,18">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Audio Pilot" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="MANAGER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Nav}" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Margin="12,4,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="14,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Quick toggles -->
                <StackPanel Grid.Row="2" Margin="16,0,16,12">
                    <TextBlock Text="Quick controls" Style="{StaticResource SectionText}" Margin="4,0,0,8" />
                    <Grid DataContext="{Binding DefaultInput}" Visibility="{Binding Converter={StaticResource NullToVis}}" Margin="0,0,0,6">
                        <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Padding="12,9" ToolTip="{Binding Name}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Grid.Column="1" Text="Microphone" Margin="12,0,0,0" FontSize="13" />
                                <c:LevelMeter Grid.Column="2" Width="60" Height="6" Level="{Binding Level}" IsDimmed="{Binding IsMuted}"
                                              Fill="{DynamicResource MeterBrush}" Track="{DynamicResource ControlBrush}" />
                            </Grid>
                        </ToggleButton>
                    </Grid>
                    <Button HorizontalContentAlignment="Stretch" Padding="12,9" Background="{DynamicResource CardBrush}" Command="{Binding CycleOutputCommand}"
                            ToolTip="Switch the default output to your next device" DataContext="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DefaultOutput.Glyph, FallbackValue=&#xE7F5;}" Style="{StaticResource Icon}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Switch output" FontSize="13" />
                                <TextBlock Text="{Binding DefaultOutput.Name, FallbackValue=No output}" Style="{StaticResource CaptionText}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Support -->
                <Border Grid.Row="3" Margin="16,4,16,16" CornerRadius="14" Padding="1" Background="{DynamicResource AccentGradientDiagonalBrush}">
                    <Border CornerRadius="13" Background="{DynamicResource PopupBrush}" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB52;" Style="{StaticResource Icon}" FontSize="13" Foreground="#FFFF5C72" />
                                <TextBlock Text="Enjoying Audio Pilot?" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="It's free and open source. Support keeps it growing." Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       TextTrimming="None" Margin="0,4,0,10" FontSize="11.5" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding OpenPatreonCommand}" Padding="10,7" FontSize="12.5"
                                    AutomationProperties.Name="Support on Patreon">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentForegroundBrush}" />
                                    <TextBlock Text="Support on Patreon" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Caption buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" FontSize="13" Click="OnPinClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Keep on top" AutomationProperties.Name="Keep on top">
                    <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource IconFont}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" />
            </StackPanel>

            <TabControl Grid.Row="1" Style="{StaticResource PageHost}" SelectedIndex="{Binding SelectedPage}" Margin="32,0,32,0">
                <TabItem><v:MixerView c:Entrance.Enabled="True" /></TabItem>
                <TabItem><v:DevicesView c:Entrance.Enabled="True" /></TabItem>
                <TabItem><v:ProfilesView c:Entrance.Enabled="True" /></TabItem>
                <TabItem><v:SettingsView c:Entrance.Enabled="True" /></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
