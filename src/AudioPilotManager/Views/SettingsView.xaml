<UserControl x:Class="AudioPilotManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudioPilotManager.Controls">
    <UserControl.Resources>
        <!-- One setting: icon, title + description, and a control on the right. -->
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Width" Value="20" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Margin" Value="36,0,0,0" />
        </Style>

        <!-- Accent swatches -->
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="5" Fill="{Binding Preview}" />
                            <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter TargetName="Check" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,14,28" MaxWidth="860" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" />
            <TextBlock Text="Make it yours. Everything saves instantly." Style="{StaticResource SubtitleText}" Margin="0,4,0,24" />

            <!-- ================================================ update banner (only when a new version is out) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,0,24"
                    Visibility="{Binding Updates.IsAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StrongText}">
                            <Run Text="Audio Pilot Manager" /> <Run Text="{Binding Updates.AvailableVersion, Mode=OneWay}" /> <Run Text="is available" />
                        </TextBlock>
                        <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Command="{Binding Updates.ViewReleaseCommand}" Content="What's new" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding Updates.InstallCommand}" Content="Install now" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================ appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE790;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="System follows your Windows setting." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource ControlBrush}" CornerRadius="9" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="System" GroupName="theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Dark" GroupName="theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Light" GroupName="theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE771;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Accent" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Colours the faders, meters and highlights." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ListBox Grid.Column="2" ItemsSource="{Binding Accents}" SelectedValuePath="Name" SelectedValue="{Binding Accent, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource SwatchItem}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Accent colour">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}" IsEnabled="{Binding BackdropSupported}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mica backdrop" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Let your wallpaper tint the window, like built-in Windows 11 apps. Needs Windows 11 22H2 or later." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding UseBackdrop}" AutomationProperties.Name="Mica backdrop" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================================ behaviour -->
            <TextBlock Text="Behaviour" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Launch when you sign in, so your volumes and shortcuts are always ready." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE921;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start quietly in the tray" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="When launched at sign-in, stay in the notification area instead of opening the window." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start in tray" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Keep running when closed" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="The close button hides to the tray. Use Exit in the tray menu to quit completely." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" AutomationProperties.Name="Keep running when closed" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE718;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Always on top" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Keep the mixer above other windows. Also on the pin in the title bar." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" AutomationProperties.Name="Always on top" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="On-screen notifications" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="A small pop-up confirms shortcuts: microphone muted, output switched, profile applied." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowOsd}" AutomationProperties.Name="On-screen notifications" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================================ mixer -->
            <TextBlock Text="Mixer" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Remember app volumes" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="When an app starts, put it back at the level and mute state you last gave it." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Forget all" FontSize="12.5" Padding="10,6" Margin="0,0,10,0"
                                Command="{Binding ForgetAppVolumesCommand}" ToolTip="Clear every remembered app volume" />
                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding RememberAppVolumes}" AutomationProperties.Name="Remember app volumes" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F5;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Show system sounds" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Notification dings and other Windows sounds get their own fader." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowSystemSounds}" AutomationProperties.Name="Show system sounds" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE720;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Live microphone meter" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Windows only measures a mic while something listens to it, so while this window is open Audio Pilot listens silently (like the Sound settings page). Nothing is recorded or stored; Windows will show the mic-in-use icon meanwhile."
                                       Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding LiveMicMeter}" AutomationProperties.Name="Live microphone meter" />
                    </Grid>
                    <StackPanel Visibility="{Binding HiddenApps.Count, Converter={x:Static c:NonZeroToVisibility.Instance}}">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xED1A;" Style="{StaticResource RowIcon}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hidden apps" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="These keep working normally; they just don't take up space in the mixer." Style="{StaticResource RowDesc}" />
                                <ItemsControl ItemsSource="{Binding HiddenApps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="12,4,4,4" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE7B3;" Margin="6,0,0,0"
                                                            ToolTip="Show in mixer again" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.UnhideAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================================================ shortcuts -->
            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE765;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Global shortcuts" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Work everywhere, even in games. Click a shortcut and press new keys to change it; Backspace clears it." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding HotkeysEnabled}" AutomationProperties.Name="Global shortcuts" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Hotkeys}" IsEnabled="{Binding HotkeysEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource RowIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource RowDesc}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource RowDesc}" Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <c:HotkeyBox Grid.Column="2" Hotkey="{Binding Binding, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================================================ updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE895;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Check for updates automatically" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Once a day, ask GitHub if a newer version has been released and let you know in the tray. Nothing else is sent, and nothing installs without your OK."
                                       Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Updates.CheckForUpdates}" AutomationProperties.Name="Check for updates automatically" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}">
                                <Run Text="Version" /> <Run Text="{Binding Updates.CurrentVersion, Mode=OneTime}" /> <Run Text="{Binding Updates.PackageKind, Mode=OneTime, StringFormat='({0})'}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource RowDesc}" />
                            <Grid Height="4" Margin="0,8,0,2" MaxWidth="320" HorizontalAlignment="Left" Width="320"
                                  Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="2" />
                                <Border Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Updates.Progress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding Updates.InstallCommand}" Content="Install update" Margin="0,0,8,0"
                                    Visibility="{Binding Updates.IsAvailable, Converter={StaticResource BoolToVis}}" />
                            <Button Command="{Binding Updates.CheckNowCommand}" Content="Check now" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================================ privacy -->
            <TextBlock Text="Privacy &amp; safety" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="Private by design" Style="{StaticResource StrongText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowDesc}" FontSize="13" LineHeight="22">
                        <Run Text="•  No telemetry, no accounts, no ads. The only network request is the optional update check to GitHub (see Updates above)." /><LineBreak />
                        <Run Text="•  Runs as a normal user and never asks for administrator rights." /><LineBreak />
                        <Run Text="•  Only uses the documented Windows audio interfaces. It never touches drivers or system files." /><LineBreak />
                        <Run Text="•  Settings and a small log stay on this PC, in your own profile folder." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding OpenSettingsFolderCommand}" Padding="12,7" FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Settings folder" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenLogsCommand}" Padding="12,7" FontSize="12.5" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Log file" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================================================ about -->
            <TextBlock Text="About" Style="{StaticResource SectionText}" />
            <Border CornerRadius="14" Padding="1" Background="{DynamicResource AccentGradientDiagonalBrush}">
                <Border CornerRadius="13" Padding="20" Background="{DynamicResource PopupBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/logo.png" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Audio Pilot Manager" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Made with care by GitHixy. Free and open source under GPL-3.0. If it makes your day a little better, a Patreon pledge helps keep it that way."
                                       Style="{StaticResource RowDesc}" FontSize="13" Margin="0,6,0,14" />
                            <WrapPanel>
                                <Button Style="{StaticResource AccentButton}" Command="{Binding OpenPatreonCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentForegroundBrush}" />
                                        <TextBlock Text="Support on Patreon" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenRepoCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Source code" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenIssuesCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEBE8;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Report a bug or idea" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
